# Copie este arquivo para .env e preencha com os seus valores.
# O .env NÃO vai para o Git (está no .gitignore).

# ------------------------------------------------------------------
# Banco de dados (PostgreSQL)
# DATABASE_URL: conexão usada pela aplicação
# DIRECT_URL:   conexão usada pelo Prisma para rodar as migrations
# ------------------------------------------------------------------

# Opção 1 — Supabase (Project Settings > Database > Connection string)
#   DATABASE_URL: pooler em modo "transaction" (porta 6543) com ?pgbouncer=true
#   DIRECT_URL:   pooler em modo "session" (porta 5432)
DATABASE_URL="postgresql://postgres.SEU_PROJECT_REF:SUA_SENHA@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.SEU_PROJECT_REF:SUA_SENHA@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# Opção 2 — PostgreSQL local (use a mesma URL nas duas)
# DATABASE_URL="postgresql://postgres:SUA_SENHA@localhost:5432/easyfood"
# DIRECT_URL="postgresql://postgres:SUA_SENHA@localhost:5432/easyfood"

# ------------------------------------------------------------------
# Autenticação
# Gere uma chave aleatória com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ------------------------------------------------------------------
JWT_SECRET="cole-aqui-a-chave-gerada"

# ------------------------------------------------------------------
# E-mails (MailerSend — https://www.mailersend.com)
# MAILER_API:  token criado em Integrations > API tokens
# DOMAIN_MAIL: só o domínio verificado no MailerSend (sem "@").
#              Os e-mails saem como no-reply@<DOMAIN_MAIL>
# Sem essas variáveis a API funciona, mas os e-mails não são enviados.
# ------------------------------------------------------------------
MAILER_API="seu-token-da-api-do-mailersend"
DOMAIN_MAIL="seu-dominio-verificado.mlsender.net"
